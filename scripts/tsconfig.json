{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {
      "phosphor-react-native/src/icons/*": [
        "../node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../src/**/*.ts"
  ],
  "exclude": [
    "../src/**/__tests__/**"
  ]
}
